# Host 127.0.0.1 (bukan localhost): port docker hanya diikat ke IPv4; localhost di Windows mencoba ::1 dulu.
# Salin ke .env lalu ganti password. Semua kredensial ini hanya untuk lingkungan lokal.

# --- SAP mock (PostgreSQL) ---
SAP_DB_HOST=127.0.0.1
SAP_DB_PORT=55432
SAP_DB_NAME=sap_mock
SAP_DB_ADMIN_USER=sap_admin
SAP_DB_ADMIN_PASSWORD=change_me_sap_admin
SAP_DB_READER_USER=sap_reader
SAP_DB_READER_PASSWORD=change_me_sap_reader

# --- Warehouse (PostgreSQL) ---
DWH_DB_HOST=127.0.0.1
DWH_DB_PORT=55433
DWH_DB_NAME=dwh
DWH_DB_USER=dwh_admin
DWH_DB_PASSWORD=change_me_dwh

# --- Data lake / bucket retailer (SeaweedFS, S3-compatible) ---
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY=lake_admin
S3_SECRET_KEY=change_me_lake_secret
S3_RETAILER_BUCKET=retailer-drop
S3_LAKE_BUCKET=lake

# --- SFTP distributor ---
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
DIST_A_PASSWORD=change_me_dist_a
DIST_B_PASSWORD=change_me_dist_b
DIST_C_PASSWORD=change_me_dist_c
SFTP_INGEST_PASSWORD=change_me_ingest

# --- Airflow ---
AIRFLOW_FERNET_KEY=change_me_fernet_32_byte_urlsafe_base64
AIRFLOW_JWT_SECRET=change_me_jwt_secret

# --- Alert (opsional) ---
# URL webhook Discord atau Slack. Kosong = alert hanya dicatat ke ops.alert_log dan logs/alerts.log
ALERT_WEBHOOK_URL=

# --- BI (Metabase) ---
BI_READER_PASSWORD=change_me_bi_reader
METABASE_ADMIN_EMAIL=admin@fmcg.local
METABASE_ADMIN_PASSWORD=change_me_metabase_admin
